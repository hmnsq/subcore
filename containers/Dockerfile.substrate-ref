#
# substrate-ref (MRD section 9.7): the reference simulators OpenModelica, ngspice, Project Chrono, Qiskit Aer
# and QuTiP, with Node.js to generate their inputs from the models (docs/src/export.js). Built when first
# needed and kept (PRF-05). tools/ref.sh runs a model in one of them and records its output.
#
# Base: OpenModelica 1.25.5, minimal image (upstream docker.io/openmodelica/openmodelica, Ubuntu 22.04),
# pinned by digest. Node.js is copied from the official Node.js 22.23.4 image (upstream docker.io/library/node).
FROM mirror.gcr.io/library/node:22.23.4-bookworm@sha256:18a6d90fd60542269850c80ca03b29b1d9b14d6b221ac7ee8e35b0d33ef904bd AS node
FROM mirror.gcr.io/openmodelica/openmodelica:v1.25.5-minimal@sha256:116ec5a9404019c8cee3111ad80e0db7f09ad7bc433c3777feb05b2418d5e57d

ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY

COPY --from=node /usr/local/bin/node /usr/local/bin/node

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ngspice curl bzip2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# micromamba 2.10.0 from its conda-forge package (checked by sha256), then two environments from conda-forge:
# Project Chrono (pychrono 9.0.1, projectchrono and conda-forge channels; PyPI's "pychrono" is an unrelated
# package) and the quantum references (Python 3.13 with pinned Qiskit, Qiskit Aer and QuTiP from PyPI).
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca REQUESTS_CA_BUNDLE=/run/secrets/ca CURL_CA_BUNDLE=/run/secrets/ca; fi; \
    curl -fsSL -o /tmp/mm.tar.bz2 https://conda.anaconda.org/conda-forge/linux-64/micromamba-2.10.0-0.tar.bz2 \
 && echo "9a97976244929bbae28fb1fae504e74a3e7e6d1932870e3a03321f01b7fbd07b  /tmp/mm.tar.bz2" | sha256sum -c - \
 && tar -xjf /tmp/mm.tar.bz2 -C /usr/local bin/micromamba && rm /tmp/mm.tar.bz2 \
 && micromamba create -y -r /opt/mamba -p /opt/chrono -c projectchrono -c conda-forge pychrono=9.0.1 python=3.13 \
 && micromamba create -y -r /opt/mamba -p /opt/quantum -c conda-forge python=3.13 pip \
 && micromamba clean -y -a -r /opt/mamba

RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export PIP_CERT=/run/secrets/ca; fi; \
    /opt/quantum/bin/pip install --no-cache-dir qiskit==2.6.1 qiskit-aer==0.18.2 qiskit-qasm3-import==0.6.0 \
      openqasm3==1.0.1 qutip==5.3.1 numpy==2.5.4 scipy==1.18.1

ENV SUBCORE_PY_QUANTUM=/opt/quantum/bin/python \
    SUBCORE_PY_CHRONO=/opt/chrono/bin/python \
    SUBCORE_OMC=omc
WORKDIR /work
LABEL org.opencontainers.image.title="subcore substrate-ref" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.vendor="AyeAI"
